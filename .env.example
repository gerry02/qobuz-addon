# HTTP server
PORT=3000
HOST=0.0.0.0
REQUEST_TIMEOUT_MS=6000
UPSTREAM_RETRIES=1
CACHE_TTL_SECONDS=300
QOBUZ_ID_SECRET=replace-with-a-long-random-secret

# Provider selection. multi races Qobuz-DL and the optional backend, first usable result wins.
QOBUZ_PROVIDER=multi
QOBUZ_UPSTREAM_BASE_URL=https://qobuz-dll.foreyou.workers.dev
OPTIONAL_BACKEND_BASE_URL=https://arcod.xyz
# LastBabe is opt-in: its upstream is decommissioned and answers 404.
# LASTBABE_BASE_URL=https://lastbabe-addon.de.deplexo.com

# Only for an authorized, documented provider implementation.
# QOBUZ_API_BASE_URL=https://api.example.invalid
# QOBUZ_SEARCH_PATH=/v1/search
# QOBUZ_STREAM_PATH=/v1/tracks/{id}/stream
# QOBUZ_API_TOKEN=
